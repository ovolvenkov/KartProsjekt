<Page
    x:Class="KartProsjekt.Views.CommunityTableViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    xmlns:local="using:KartProsjekt.ViewModels">

    <Grid Padding="32"
          Background="{ThemeResource AppBackgroundBrush}"
          RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Matches the existing project pages while keeping table actions together. -->
        <Grid Grid.Row="0" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Community TableView"
                FontSize="32"
                FontWeight="SemiBold"
                VerticalAlignment="Center"/>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">
                <Button
                    Content="Reset sorting"
                    Click="ResetSorting_Click"
                    Padding="16,10"
                    CornerRadius="8"/>
                <Button
                    Content="Clear filters"
                    Click="ClearFilters_Click"
                    Padding="16,10"
                    CornerRadius="8"/>
                <Button
                    Content="＋ Add Project"
                    Click="AddProject_Click"
                    Padding="16,10"
                    CornerRadius="8"/>
            </StackPanel>
        </Grid>

        <!-- Column filter menus remain independent from this global in-memory search. -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                Header="Search projects"
                PlaceholderText="Search all project fields"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="SearchTextBox_TextChanged"/>
            <TextBlock
                Grid.Column="1"
                Text="Click a column menu to filter or group. Ctrl+Click headers to add sort levels."
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                Opacity="0.75"/>
        </Grid>

        <!-- Uses the library's virtualized view, built-in filtering/grouping, and cell selection. -->
        <tv:TableView
            x:Name="CommunityTable"
            Grid.Row="2"
            ItemsSource="{Binding VisibleProjects}"
            AutoGenerateColumns="False"
            CanSortColumns="True"
            CanFilterColumns="True"
            CanGroupColumns="True"
            CanResizeColumns="True"
            CanReorderColumns="True"
            AllowLiveShaping="True"
            ShowSortableColumnIcon="True"
            ShowFilterItemsCount="True"
            ShowExportOptions="True"
            CanCopy="True"
            CanPaste="True"
            FrozenColumnCount="2"
            ColumnResizeMode="Preview"
            SelectionMode="Extended"
            SelectionUnit="CellOrRow"
            BeginningEdit="CommunityTable_BeginningEdit"
            CellEditEnded="CommunityTable_CellEditEnded"
            PasteFromClipboard="CommunityTable_PasteFromClipboard"
            AutomationProperties.HelpText="Arrow keys navigate cells; Tab moves between editable cells; Enter commits and Escape cancels. Ctrl+Click adds a secondary sort.">
            <tv:TableView.Columns>
                <tv:TableViewTextColumn
                    Header="Project Number"
                    Width="140"
                    SortMemberPath="ProjectNumber"
                    IsReadOnly="True"
                    Binding="{Binding ProjectNumber}"/>
                <tv:TableViewTextColumn
                    Header="Project Name"
                    Width="220"
                    SortMemberPath="Name"
                    Binding="{Binding Name}"/>
                <tv:TableViewTextColumn
                    Header="Municipality"
                    Width="150"
                    SortMemberPath="Municipality"
                    Binding="{Binding Municipality}"/>
                <tv:TableViewComboBoxColumn
                    Header="Category"
                    Width="140"
                    SortMemberPath="Category"
                    Binding="{Binding Category}"
                    ItemsSource="{x:Bind local:ProjectTableViewModel.EditableCategoryOptions}"/>
                <tv:TableViewTextColumn
                    Header="Project Manager"
                    Width="170"
                    SortMemberPath="ProjectManager"
                    Binding="{Binding ProjectManager}"/>
                <tv:TableViewNumberColumn
                    Header="Budget (NOK)"
                    Width="140"
                    SortMemberPath="Budget"
                    Binding="{Binding Budget}"/>
                <tv:TableViewNumberColumn
                    Header="Actual Cost (NOK)"
                    Width="150"
                    SortMemberPath="ActualCost"
                    Binding="{Binding ActualCost}"/>
                <tv:TableViewComboBoxColumn
                    Header="Status"
                    Width="130"
                    SortMemberPath="Status"
                    Binding="{Binding Status}"
                    ItemsSource="{x:Bind local:ProjectTableViewModel.EditableStatusOptions}"/>
                <tv:TableViewComboBoxColumn
                    Header="Priority"
                    Width="100"
                    SortMemberPath="Priority"
                    Binding="{Binding Priority}"
                    ItemsSource="{x:Bind local:ProjectTableViewModel.EditablePriorityOptions}"/>
                <tv:TableViewNumberColumn
                    Header="Progress (%)"
                    Width="120"
                    SortMemberPath="Progress"
                    Binding="{Binding Progress}"/>
                <tv:TableViewDateColumn
                    Header="Start Date"
                    Width="140"
                    SortMemberPath="StartDate"
                    DateFormat="shortdate"
                    IsReadOnly="True"
                    Binding="{Binding StartDate}"/>
                <tv:TableViewDateColumn
                    Header="End Date"
                    Width="140"
                    SortMemberPath="EndDate"
                    DateFormat="shortdate"
                    IsReadOnly="True"
                    Binding="{Binding EndDate}"/>
                <tv:TableViewTextColumn
                    Header="Created At"
                    Width="170"
                    SortMemberPath="CreatedAt"
                    IsReadOnly="True"
                    Binding="{Binding CreatedAt}"/>
                <tv:TableViewCheckBoxColumn
                    Header="Is Archived"
                    Width="120"
                    SortMemberPath="IsArchived"
                    IsReadOnly="True"
                    Binding="{Binding IsArchived}"/>
            </tv:TableView.Columns>
        </tv:TableView>

        <TextBlock
            Grid.Row="3"
            Text="{Binding StatusMessage}"
            AutomationProperties.LiveSetting="Polite"
            TextTrimming="CharacterEllipsis"
            Opacity="0.75"/>
    </Grid>
</Page>
