<Page
    x:Class="KartProsjekt.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32" Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel Spacing="24" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Settings"
                    FontSize="32"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Text="Customize the appearance and navigation."
                    Opacity="0.65"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    Text="App theme"
                    FontSize="18"
                    FontWeight="SemiBold"/>
                <TextBlock
                    Text="Choose System to follow your Windows appearance."
                    Opacity="0.65"/>
                <ComboBox
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                    MinWidth="220"
                    HorizontalAlignment="Left"/>
            </StackPanel>

            <ToggleSwitch
                Header="Compact navigation"
                OnContent="Compact"
                OffContent="Expanded"
                IsOn="{Binding IsCompactNavigation, Mode=TwoWay}"/>
        </StackPanel>
    </Grid>
</Page>
