<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="KartProsjekt.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KartProsjekt">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
                <!-- Provides the required theme resources for TableView controls. -->
                <TabularControlsResources xmlns="using:Microsoft.UI.Xaml.Controls.Tabular"/>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF5F5F5"/>
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#FFE5E5E5"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF5F5F5"/>
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#FFE5E5E5"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF000000"/>
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FF0A0A0A"/>
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#FF242424"/>
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefault" Color="#FF0A0A0A"/>
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF0A0A0A"/>
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF141414"/>
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF1F1F1F"/>
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF0A0A0A"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
